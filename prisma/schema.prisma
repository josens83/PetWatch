generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User Model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  pets         Pet[]
  subscription Subscription?
}

// Subscription Model
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

// Pet Model
model Pet {
  id                  String        @id @default(cuid())
  ownerId             String
  name                String
  species             Species
  breed               String
  birthDate           DateTime
  gender              Gender
  neutered            Boolean       @default(false)
  weight              Float
  bodyConditionScore  Int           @default(5)
  size                PetSize
  profileImage        String?
  furColor            String?
  distinctiveFeatures String?
  activityLevel       ActivityLevel @default(MODERATE)
  dietType            DietType      @default(DRY_FOOD)
  allergies           String[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  healthConditions HealthCondition[]
  medications      Medication[]
  vaccinations     Vaccination[]
  healthLogs       DailyHealthLog[]
  healthAnalyses   HealthAnalysis[]
  healthAlerts     HealthAlert[]
}

enum Species {
  DOG
  CAT
}

enum Gender {
  MALE
  FEMALE
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
  GIANT
}

enum ActivityLevel {
  LOW
  MODERATE
  HIGH
}

enum DietType {
  DRY_FOOD
  WET_FOOD
  RAW
  HOMEMADE
  PRESCRIPTION
  MIXED
}

// Health Condition Model
model HealthCondition {
  id           String                    @id @default(cuid())
  petId        String
  name         String
  diagnosedDate DateTime
  severity     HealthConditionSeverity
  status       HealthConditionStatus    @default(ACTIVE)
  notes        String?
  vetVerified  Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

enum HealthConditionSeverity {
  MILD
  MODERATE
  SEVERE
}

enum HealthConditionStatus {
  ACTIVE
  MANAGED
  RESOLVED
}

// Medication Model
model Medication {
  id            String   @id @default(cuid())
  petId         String
  name          String
  dosage        String
  frequency     String
  startDate     DateTime
  endDate       DateTime?
  reminders     Boolean  @default(true)
  reminderTimes String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// Vaccination Model
model Vaccination {
  id               String   @id @default(cuid())
  petId            String
  name             String
  dateAdministered DateTime
  nextDueDate      DateTime
  vetClinic        String?
  certificate      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// Daily Health Log Model
model DailyHealthLog {
  id               String      @id @default(cuid())
  petId            String
  date             DateTime    @db.Date
  waterIntake      Int?
  weight           Float?
  overallCondition Int         @default(3)
  energyLevel      Int         @default(3)
  appetiteLevel    Int         @default(3)
  observations     String?
  photos           String[]
  source           LogSource   @default(MANUAL)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  pet          Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  meals        MealLog[]
  eliminations EliminationLog[]
  activity     ActivityLog?

  @@unique([petId, date])
}

enum LogSource {
  MANUAL
  IOT
  MIXED
}

// Meal Log Model
model MealLog {
  id             String   @id @default(cuid())
  healthLogId    String
  time           DateTime
  type           MealType
  foodBrand      String?
  foodProduct    String?
  foodType       DietType @default(DRY_FOOD)
  isNewFood      Boolean  @default(false)
  amount         Int
  consumedPercent Int     @default(100)
  enthusiasm     Int      @default(3)
  vomitedAfter   Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())

  healthLog DailyHealthLog @relation(fields: [healthLogId], references: [id], onDelete: Cascade)
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  TREAT
}

// Elimination Log Model
model EliminationLog {
  id              String          @id @default(cuid())
  healthLogId     String
  time            DateTime
  type            EliminationType
  fecesConsistency Int?
  fecesColor      String?
  urineColor      String?
  urineAmount     String?
  straining       Boolean         @default(false)
  frequency       String          @default("normal")
  usedLitterBox   Boolean?
  hadAccident     Boolean         @default(false)
  notes           String?
  photo           String?
  createdAt       DateTime        @default(now())

  healthLog DailyHealthLog @relation(fields: [healthLogId], references: [id], onDelete: Cascade)
}

enum EliminationType {
  URINE
  FECES
}

// Activity Log Model
model ActivityLog {
  id            String   @id @default(cuid())
  healthLogId   String   @unique
  playTime      Int      @default(0)
  restTime      Int      @default(0)
  steps         Int?
  activeMinutes Int?
  sleepHours    Float?
  sleepQuality  Int?
  createdAt     DateTime @default(now())

  healthLog DailyHealthLog       @relation(fields: [healthLogId], references: [id], onDelete: Cascade)
  walks     WalkLog[]
  behaviors BehaviorObservation[]
}

// Walk Log Model
model WalkLog {
  id            String   @id @default(cuid())
  activityLogId String
  startTime     DateTime
  endTime       DateTime
  duration      Int
  distance      Float?
  poopCount     Int      @default(0)
  peeCount      Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
}

// Behavior Observation Model
model BehaviorObservation {
  id            String   @id @default(cuid())
  activityLogId String
  behavior      String
  frequency     String   @default("once")
  notes         String?
  createdAt     DateTime @default(now())

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
}

// Health Analysis Model
model HealthAnalysis {
  id                  String   @id @default(cuid())
  petId               String
  date                DateTime @db.Date
  overallHealthScore  Int
  nutritionScore      Int
  nutritionStatus     String
  nutritionDetails    String?
  nutritionChange     String   @default("stable")
  digestionScore      Int
  digestionStatus     String
  digestionDetails    String?
  digestionChange     String   @default("stable")
  activityScore       Int
  activityStatus      String
  activityDetails     String?
  activityChange      String   @default("stable")
  hydrationScore      Int
  hydrationStatus     String
  hydrationDetails    String?
  hydrationChange     String   @default("stable")
  behaviorScore       Int
  behaviorStatus      String
  behaviorDetails     String?
  behaviorChange      String   @default("stable")
  recommendations     String[]
  vetVisitRecommended Boolean  @default(false)
  vetVisitUrgency     String?
  vetVisitReason      String?
  createdAt           DateTime @default(now())

  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  anomalies Anomaly[]
  trends    HealthTrend[]

  @@unique([petId, date])
}

// Anomaly Model
model Anomaly {
  id                 String   @id @default(cuid())
  analysisId         String
  type               String
  severity           String
  description        String
  detectedAt         DateTime @default(now())
  dataPoints         String[]
  possibleCauses     String[]
  recommendedActions String[]

  analysis HealthAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

// Health Trend Model
model HealthTrend {
  id            String @id @default(cuid())
  analysisId    String
  metric        String
  direction     String
  percentChange Float
  period        String

  analysis HealthAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

// Health Alert Model
model HealthAlert {
  id          String    @id @default(cuid())
  petId       String
  type        String
  severity    String
  title       String
  message     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  actionTaken Boolean   @default(false)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}
